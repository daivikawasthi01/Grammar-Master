# Copy to .env.local and fill in. The app refuses to start if a required value is missing.

# Required
MONGODB_URI=mongodb://127.0.0.1:27017/grammar-master
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=
GROQ_API_KEY=

# Production: shared rate limits and AI response cache across instances.
# Without these, both are per-process (fine for local development).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional
# AI checks/rewrites per user per calendar month (default 1000).
MONTHLY_AI_LIMIT=
# fatal | error | warn | info | debug | trace | silent (default info)
LOG_LEVEL=
# Enables error reporting. Request bodies, cookies and headers are never sent.
SENTRY_DSN=
