# Copy this file to .env.local and fill in real values for local development
MONGODB_URI=mongodb://127.0.0.1:27017/grammar-master
JWT_SECRET=change-me
GROQ_API_KEY=your_groq_api_key_here
NEXTAUTH_SECRET=change-me
NEXTAUTH_URL=http://localhost:3000

# Upstash Redis for production rate limiting (preferred)
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# Optional legacy backup for local testing only
REDIS_URL=redis://localhost:6379
